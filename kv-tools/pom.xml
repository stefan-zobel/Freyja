<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.stefan-zobel</groupId>
        <artifactId>Freyja</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>kv-tools</artifactId>

    <properties>
        <!-- The external fault suite starts processes and breaks them; it runs only in its profile. -->
        <excludedTestGroups>external</excludedTestGroups>
        <includedTestGroups/>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <groups>${includedTestGroups}</groups>
                    <excludedGroups>${excludedTestGroups}</excludedGroups>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- ./mvnw -pl kv-tools -am test -Pexternal-faults [-Dfreyja.external.runs=50]
             Clusters of real processes under kills, pauses, and network faults; the histories
             of their clients are checked (docs/spec/verification.md, section 4). -->
        <profile>
            <id>external-faults</id>
            <properties>
                <excludedTestGroups/>
                <includedTestGroups>external</includedTestGroups>
            </properties>
        </profile>
    </profiles>

    <dependencies>
        <dependency>
            <groupId>io.github.stefan-zobel</groupId>
            <artifactId>lsm-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.stefan-zobel</groupId>
            <artifactId>kv-node</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- The end-to-end test drives a cluster of processes with the client library. -->
        <dependency>
            <groupId>io.github.stefan-zobel</groupId>
            <artifactId>kv-client</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- The external fault suite checks its histories with the checker of the simulator. -->
        <dependency>
            <groupId>io.github.stefan-zobel</groupId>
            <artifactId>raft-sim</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.stefan-zobel</groupId>
        <artifactId>Freyja</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>kv-node</artifactId>

    <properties>
        <!-- The continuous simulation runs for as long as it is told and only in its profile. -->
        <excludedTestGroups>continuous</excludedTestGroups>
        <includedTestGroups/>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <groups>${includedTestGroups}</groups>
                    <excludedGroups>${excludedTestGroups}</excludedGroups>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- ./mvnw -pl kv-node -am test -Pcontinuous-simulation -Dfreyja.sim.minutes=60
             Works through fresh seeds of the whole-system simulation for the given time,
             files every failing seed into the corpus, and writes a report. -->
        <profile>
            <id>continuous-simulation</id>
            <properties>
                <excludedTestGroups/>
                <includedTestGroups>continuous</includedTestGroups>
            </properties>
        </profile>
    </profiles>

    <dependencies>
        <dependency>
            <groupId>io.github.stefan-zobel</groupId>
            <artifactId>kv-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.stefan-zobel</groupId>
            <artifactId>lsm-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.stefan-zobel</groupId>
            <artifactId>raft-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- The whole-system simulation checks client histories with the checker of raft-sim. -->
        <dependency>
            <groupId>io.github.stefan-zobel</groupId>
            <artifactId>raft-sim</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- The client library is tested against real nodes here; a node does not use it. -->
        <dependency>
            <groupId>io.github.stefan-zobel</groupId>
            <artifactId>kv-client</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
